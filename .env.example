# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# RAG_EMBEDDING_PROVIDER=openai          # openai | huggingface | hashing
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_JUDGE_MODEL=gpt-4o-mini
# RAG_RERANKER=cross-encoder             # cross-encoder | llm | none
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_FETCH_K=20                         # candidates pulled from FAISS
# RAG_TOP_K=4                            # chunks kept after re-ranking
