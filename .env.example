# Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# OpenAI (optional, only if using openai provider)
# OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# RAG_EMBEDDING_PROVIDER=google          # google | openai | huggingface | hashing
# RAG_EMBEDDING_MODEL=models/text-embedding-004
# RAG_LLM_MODEL=gemini-1.5-flash
# RAG_JUDGE_MODEL=gemini-1.5-flash
# RAG_RERANKER=cross-encoder             # cross-encoder | llm | none
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_FETCH_K=20                         # candidates pulled from FAISS
# RAG_TOP_K=4                            # chunks kept after re-ranking
